{
  "manifest_version": 3,
  "name": "Mute Twitch Ads",
  "version": "3.0.0",
  "description": "Will automatically mute any Twitch streams if it plays an ad.",
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch-ad-muter@example.com"
    }
  },
  "host_permissions": ["*://www.twitch.tv/*"],
  "permissions": ["tabs"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://www.twitch.tv/*"],
      "js": ["mute_tab.js"]
    }
  ],
  "action": {
    "default_icon": {
      "48": "twitch_ad_mute_icon_48.png"
    }
  }
}
